# Telegram BotFather dan olingan bot tokeni
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Bot egasining Telegram ID si (@userinfobot orqali bilib oling)
ADMIN_ID=123456789

# Har bir foydalanuvchi uchun bepul yuklab olish limiti (masalan: 1000)
FREE_DOWNLOAD_LIMIT=1000

# Telegram Premium foydalanuvchilariga avtomatik cheksiz ruxsat berish (True yoki False)
AUTO_TELEGRAM_PREMIUM_VIP=True

# Majburiy a'zo bo'linadigan kanal (agar bo'lmasa, bo'sh qoldiring)
REQUIRED_CHANNEL=
